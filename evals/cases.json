{
  "about": "Labelled cases: a deck and a memo with planted fabrications, checked against a short fact sheet. `expect` lists what must be flagged; `clean` lists claim text, or a number on its own, that must not be. `model` entries are only scored when the model runs.",
  "cases": [
    {
      "name": "deck: bike-share annual update",
      "document": "fixtures/bike_share_update.pptx",
      "evidence": ["fixtures/bike_share_facts.md"],
      "expect": [
        {"code": "ONS002", "number": "Q1 2025", "text": "Q1 2025"},
        {"code": "ONS002", "number": "Q1 2025", "text": "Riverside internal data, Q1 2025."},
        {"code": "ONS002", "number": "Q1 2025", "text": "Riverside internal view, Q1 2025."},
        {"code": "ONS001", "number": "95%", "text": "renewal above 95%"},
        {"code": "ONS002", "number": "18 months", "text": "over 18 months"},
        {"code": "ONS002", "number": "2023", "text": "the 2023 flood closures"},
        {"code": "ONS002", "number": "Q2", "text": "One ask before Q2."},
        {"code": "ONS102", "model": true, "text": "The repair backlog is now below weekly capacity"},
        {"code": "ONS101", "model": true, "text": "Riders keep coming back because the stations sit beside daily commute routes"}
      ],
      "clean": ["$2.4M", "Up 42% year over year", "88%", "Repair backlog at 1.4x capacity, down from 2.1x", "24",
                "Two thirds of new docks are going here.", "Confirm Q3 maintenance window by 15 March.",
                "Where we are expanding in 2026."]
    },
    {
      "name": "memo: planted fabrications",
      "document": "fixtures/bike_share_memo.md",
      "evidence": ["fixtures/bike_share_facts.md"],
      "expect": [
        {"code": "ONS003", "number": "Eight", "text": "Eight of our 24 stations sit on hills."},
        {"code": "ONS002", "number": "2023", "text": "down from 2.1x in 2023"},
        {"code": "ONS002", "number": "two years", "text": "Repair turnaround improved 33% in two years."},
        {"code": "ONS002", "number": "Q4 2025", "text": "active as of Q4 2025"}
      ],
      "clean": ["Fare revenue reached $2.4M, up 42% year over year.", "Member renewal rate is 88%.",
                "Two thirds of new docks go to the east bank.",
                "Please confirm Q3 maintenance window by 15 March."],
      "clean_with_model": ["We hold three plans for 2026."]
    },
    {
      "name": "memo: dock network rollout",
      "document": "fixtures/dock_network_memo.md",
      "evidence": ["fixtures/dock_network_facts.md"],
      "expect": [
        {"code": "ONS001", "number": "$2.4B", "text": "Annual network revenue is $2.4B."},
        {"code": "ONS001", "number": "$5M", "text": "A spares order of $5-7M closes next month."},
        {"code": "ONS001", "number": "$7M", "text": "A spares order of $5-7M closes next month."},
        {"code": "ONS001", "number": "1980", "text": "Each hub holds 1980 bikes."},
        {"code": "ONS002", "number": "2017", "text": "We opened the second depot in 2017."},
        {"code": "ONS001", "number": "50%", "text": "Margins improved 50% last year."}
      ],
      "clean": ["The new pumping shed cost about $0.4B.", "The dredging contract runs $2-3M.",
                "The rebuild runs 18-24 months.", "Margins hold at 2-3%.",
                "The pilot serves 2000 riders.", "Each controller ships 2048-bit keys.",
                "We launched in 2019.", "We employ the 2000 staff.", "66% of docks go east."]
    },
    {
      "name": "deck: grouped KPI tiles",
      "document": "fixtures/bike_share_kpis.pptx",
      "evidence": ["fixtures/bike_share_facts.md"],
      "expect": [
        {"code": "ONS001", "number": "1.2x", "text": "1.2x"},
        {"code": "ONS001", "number": "$3.1M", "text": "Fare revenue target of $3.1M for 2026"},
        {"code": "ONS002", "number": "Q4 2025", "text": "Riverside internal data, Q4 2025."}
      ],
      "clean": ["$2.4M", "Up 42% year over year", "88%",
                "Two thirds of new docks are going to the east bank."]
    },
    {
      "name": "deck: charts as pictures",
      "document": "fixtures/bike_share_charts.pptx",
      "evidence": ["fixtures/bike_share_facts.md"],
      "expect": [
        {"code": "ONS001", "model": true, "number": "1.2x", "text": "1.2x"},
        {"code": "ONS002", "model": true, "number": "Q4 2025", "text": "Q4 2025"},
        {"code": "ONS001", "model": true, "number": "$3.1M", "text": "$3.1M"}
      ],
      "clean": ["2.1x", "1.4x", "33%", "$2.4M", "42%", "88%",
                "Two thirds of new docks are going to the east bank."]
    },
    {
      "name": "deck: native charts",
      "document": "fixtures/bike_share_native_charts.pptx",
      "evidence": ["fixtures/bike_share_facts.md"],
      "expect": [
        {"code": "ONS001", "number": "1.2x", "text": "Backlog, 2026 target: 1.2x"},
        {"code": "ONS001", "number": "3100000", "text": "Fare revenue, 2026 target: 3100000"}
      ],
      "clean": ["Backlog, Before: 2.1x", "Backlog, Now: 1.4x", "Fare revenue, This year: 2400000",
                "Members, Renewed: 88%", "Two thirds of new docks are going to the east bank."]
    }
  ]
}
